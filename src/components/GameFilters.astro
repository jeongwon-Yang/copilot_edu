---
interface Option {
    id: number;
    name: string;
}

interface Props {
    categories: Option[];
    publishers: Option[];
    total: number;
}

const { categories, publishers, total } = Astro.props;
const focus = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    id="game-filters"
    class="mb-6 bg-slate-800/60 border border-slate-700/50 rounded-xl p-4 flex flex-col gap-4 md:flex-row md:items-start"
    data-testid="game-filters"
    data-total={total}
    aria-label="Filter games"
>
    <fieldset class="flex-1">
        <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-full bg-slate-700/60 px-3 py-1 text-sm text-slate-100 cursor-pointer has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class={`rounded border-slate-500 bg-slate-800 text-blue-500 ${focus}`}
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="md:w-64">
        <label for="publisher-filter" class="block text-sm font-medium text-slate-300 mb-2">Publisher</label>
        <select
            id="publisher-filter"
            name="publisher"
            class={`w-full rounded-lg bg-slate-700 border border-slate-600 text-slate-100 px-3 py-2 ${focus}`}
            data-testid="filter-publisher"
        >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
        </select>
    </div>

    <div class="flex flex-col gap-2 md:items-end">
        <button
            type="button"
            id="filter-reset"
            class={`rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 px-4 py-2 text-sm transition-colors ${focus}`}
            data-testid="filter-reset"
        >
            Clear filters
        </button>
        <p id="filter-status" role="status" aria-live="polite" class="text-sm text-slate-400" data-testid="filter-status"></p>
    </div>
</form>

<script>
    const form = document.getElementById('game-filters') as HTMLFormElement | null;
    if (form) {
        const total = Number(form.dataset.total);
        const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
        const select = form.querySelector<HTMLSelectElement>('select[name="publisher"]')!;
        const status = document.getElementById('filter-status')!;
        const noResults = document.getElementById('no-results');
        const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

        const apply = (updateUrl: boolean): void => {
            const selected = checkboxes.filter((c) => c.checked).map((c) => c.value);
            const publisher = select.value;
            let visible = 0;
            for (const card of cards) {
                const show =
                    (selected.length === 0 || selected.includes(card.dataset.categoryId ?? '')) &&
                    (publisher === '' || card.dataset.publisherId === publisher);
                card.hidden = !show;
                if (show) visible++;
            }
            if (noResults) noResults.hidden = visible !== 0;
            const filtered = selected.length > 0 || publisher !== '';
            status.textContent = filtered ? `Showing ${visible} of ${total} games` : '';

            if (updateUrl) {
                const params = new URLSearchParams();
                selected.forEach((id) => params.append('category', id));
                if (publisher) params.set('publisher', publisher);
                const query = params.toString();
                history.replaceState(null, '', query ? `?${query}` : location.pathname);
            }
        };

        const params = new URLSearchParams(location.search);
        const initial = params.getAll('category');
        checkboxes.forEach((c) => (c.checked = initial.includes(c.value)));
        select.value = params.get('publisher') ?? '';
        if (select.selectedIndex === -1) select.value = '';

        form.addEventListener('change', () => apply(true));
        form.addEventListener('submit', (e) => e.preventDefault());
        document.getElementById('filter-reset')!.addEventListener('click', () => {
            form.reset();
            apply(true);
        });
        apply(false);
    }
</script>
